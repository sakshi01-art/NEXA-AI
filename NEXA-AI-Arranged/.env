# ============================================
# NEXA AI - Environment Configuration
# ============================================

# === AI PROVIDERS ===
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_key_here

# === VOICE PROVIDERS ===
STT_PROVIDER=openai_whisper
TTS_PROVIDER=elevenlabs

ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=your_voice_id
GOOGLE_SPEECH_CREDENTIALS=./credentials/google_speech.json

# === WAKE WORD ===
WAKE_WORD_PROVIDER=porcupine
PORCUPINE_ACCESS_KEY=your_porcupine_key
WAKE_WORD=nexa

# === DATABASE ===
DATABASE_URL=sqlite:///./data/nexa.db
VECTOR_DB_PATH=./data/memory

# === SERVER ===
BACKEND_HOST=localhost
BACKEND_PORT=8000
WEBSOCKET_PORT=8765
REMOTE_ASSIST_PORT=8766

# === SECURITY ===
SECRET_KEY=your_secret_key_change_this
ALLOW_TERMINAL_EXECUTION=true
ALLOW_FILE_DELETION=false
ALLOW_SYSTEM_CHANGES=false
REQUIRE_CONFIRMATION_DESTRUCTIVE=true
DEMO_MODE=false

# === FEATURES ===
ENABLE_PROACTIVE_ASSISTANT=true
ENABLE_SCREEN_ANALYSIS=true
ENABLE_CLIPBOARD_MANAGER=true
ENABLE_CODE_INTELLIGENCE=true
ENABLE_DOCUMENT_INTELLIGENCE=true
ENABLE_REMOTE_ASSISTANCE=false
ENABLE_PLUGIN_SYSTEM=true

# === PATHS ===
DOWNLOADS_PATH=%USERPROFILE%\Downloads
DOCUMENTS_PATH=%USERPROFILE%\Documents
DESKTOP_PATH=%USERPROFILE%\Desktop
PLUGINS_PATH=./plugins
LOGS_PATH=./logs

# === LOGGING ===
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_RETENTION_DAYS=30

# === UI ===
DEFAULT_THEME=dark
DEFAULT_ACCENT_COLOR=#6366F1
ANIMATION_INTENSITY=medium
COMPACT_MODE=false
FLOATING_WIDGET=false

# === INTEGRATIONS ===
GITHUB_TOKEN=your_github_token
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
DISCORD_WEBHOOK_URL=your_discord_webhook
SLACK_API_TOKEN=your_slack_token
NOTION_API_KEY=your_notion_key
